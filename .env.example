# Copy to .env and fill in. Values below work for local development.

# ── API ──────────────────────────────────────────────
# Local API port (takes priority over PORT). Hosts set PORT in production.
API_PORT=3000
SITE_URL=http://localhost:5173
# Matches docker-compose.yml (local development only)
DATABASE_URL=postgres://painting:painting@localhost:5432/painting

SESSION_SECRET=
# Cloudflare Turnstile. These are Cloudflare's public TEST keys (always pass) for local
# development; use real keys from the Cloudflare dashboard in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Delete requests (and their photos) older than this many days. 0 keeps everything.
RETENTION_DAYS=365
# Folder for uploaded photos (default ./data/uploads). Use a persistent volume in production.
UPLOAD_DIR=
# Web Push (generate with: npx web-push generate-vapid-keys). Push is off if unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.test
# Admin email via Resend (resend.com). Email is off if unset.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# Language of admin emails: en or ms
ADMIN_NOTIFY_LANG=en

# ── Web (Vite, exposed to the browser) ───────────────
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
